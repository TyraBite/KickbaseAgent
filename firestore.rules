rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the one known, authorized UID may read the computed dashboard
    // snapshot. Everything else (Phase 1's raw per-table collections)
    // stays deny-all for clients - only the Admin SDK (server-side
    // pipeline, firebase-service-account.json) writes there, and Admin
    // SDK access bypasses these rules entirely.
    match /dashboard_snapshot/{document=**} {
      allow read: if request.auth != null
                  && request.auth.uid == "lC85qOItQ1M6bRjzqnYcgBkLVDF2";
      allow write: if false; // only the pipeline (Admin SDK) writes this
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
